# Copy to .env and fill in. .env is git-ignored: never commit it, print it or paste it anywhere.
# Qloo hackathon API key (from the hackathon organisers). Required.
QLOO_API_KEY=
# Anthropic API key (console.anthropic.com). Required for Claude features and the Claude backtest competitor.
ANTHROPIC_API_KEY=
# Groq API key (console.groq.com). Only needed to re-run the backtest's "AI alone" competitor.
GROQ_API_KEY=

# Web API settings (optional; the values shown are the defaults).
# BABEL_CORS_ORIGINS=              # comma-separated origins allowed to call the API from a browser (none by default)
# BABEL_PLAN_RATE=10/60            # POST /plan per client per 60 seconds
# BABEL_READ_RATE=120/60           # other GETs per client per 60 seconds (/health is never limited)
# BABEL_LOOKUP_RATE=30/60          # POST /lookalikes and GET /games/{appid} (may call Steam, Qloo or Claude)
# BABEL_MCP_RATE=60/60             # requests to the MCP endpoint /mcp (one tool call is several requests)
# BABEL_COMPUTE_RATE=300/60        # POST /fit-budget (the Plan screen's budget slider; no external calls)
# BABEL_ASSISTANT_RATE=20/60       # POST /assistant per client per 60 seconds (each message may call Claude)
# BABEL_MCP_ALLOWED_HOSTS=         # public host names allowed to reach /mcp, e.g. babel.example.com (localhost always)
# BABEL_MAX_BODY_BYTES=16384
# BABEL_PLAN_TIMEOUT=120           # seconds for one plan
# BABEL_MAX_CONCURRENT=4           # plans running at once
# BABEL_CACHE_SIZE=256             # finished plans kept in memory
# BABEL_UPSTREAM_ATTEMPTS=3        # tries per Steam / Qloo / Claude request
# BABEL_UPSTREAM_MAX_WAIT=5        # seconds between tries
# BABEL_UPSTREAM_TIMEOUT=30        # seconds per request
# BABEL_TRUST_PROXY=0              # 1 only behind a reverse proxy that sets X-Forwarded-For
# BABEL_WARMUP=1                   # load runtime data at startup
# BABEL_RUNTIME_DATA=              # folder of the precomputed runtime data (default data/runtime; 'off' = build it
#                                  # from the API cache at startup, about 30 s)
