      "boundElements": null,
      "updated": 1791970503859,
      "link": null,
      "locked": false,
      "text": "python tools/build_deploy.py\n1. run the 4 demo games with every request refused, recording the\ncache files they read\n2. copy the code, the runtime data and only those cache files\n3. scan every file for secrets\n4. run the demos again from the bundle alone (no network, runtime data\nrequired)",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 118,
      "containerId": "build",
      "originalText": "python tools/build_deploy.py\n1. run the 4 demo games with every request refused, recording the\ncache files they read\n2. copy the code, the runtime data and only those cache files\n3. scan every file for secrets\n4. run the demos again from the bundle alone (no network, runtime data\nrequired)",
      "lineHeight": 1.15
    },
