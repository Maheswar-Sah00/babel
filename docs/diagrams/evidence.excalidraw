      "isDeleted": false,
      "boundElements": null,
      "updated": 1791970503711,
      "link": null,
      "locked": false,
      "text": "Qloo fan maps track which games over-index on which language: correlation +0.113 (Steam) and +0.185 (Wikipedia), both p <= 0.001.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
