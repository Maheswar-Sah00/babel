      "boundElements": null,
      "updated": 1791970503710,
      "link": null,
      "locked": false,
      "text": "Most of the gain over the generic list comes from the typical mix, not from Qloo. Qloo adds a measured, game-specific signal on top.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Most of the gain over the generic list comes from the typical mix, not from Qloo. Qloo adds a measured, game-specific signal on top.",
      "lineHeight": 1.15
    },
    {
      "id": "t10",
