      "boundElements": null,
      "updated": 1791970503720,
      "link": null,
      "locked": false,
      "text": "Limits we publish\nProxies, not sales: Wikipedia attention and reviews of English-only games. Chinese, Japanese and Korean\naudiences are under-counted in both. New indie games have no Qloo data of their own, so Babel reads look-\nalikes.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 69,
      "containerId": "limits",
      "originalText": "Limits we publish\nProxies, not sales: Wikipedia attention and reviews of English-only games. Chinese, Japanese and Korean\naudiences are under-counted in both. New indie games have no Qloo data of their own, so Babel reads look-\nalikes.",
      "lineHeight": 1.15
    },
