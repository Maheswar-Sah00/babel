      "boundElements": null,
      "updated": 1791970502504,
      "link": null,
      "locked": false,
      "text": "LLM (a large language model)\nReads descriptions and writes explanations. Never\nmakes a number.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 51,
      "containerId": "r0",
      "originalText": "LLM (a large language model)\nReads descriptions and writes explanations. Never\nmakes a number.",
