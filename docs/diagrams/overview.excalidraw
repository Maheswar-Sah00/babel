      "isDeleted": false,
      "boundElements": null,
      "updated": 1791970502500,
      "link": null,
      "locked": false,
      "text": "4. Which languages\nCountries become\nlanguages, weighted by\nthe typical language\nmix of indie games",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 88,
      "containerId": "s3",
      "originalText": "4. Which languages\nCountries become\nlanguages, weighted by\nthe typical language\nmix of indie games",
      "lineHeight": 1.15
    },
    {
      "id": "WyH0nEuPqUip6z-a5zH36",
      "type": "text",
      "x": 1053.453125,
      "y": 169,
      "width": 160.09375,
