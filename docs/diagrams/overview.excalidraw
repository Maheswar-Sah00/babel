      "isDeleted": false,
      "boundElements": null,
      "updated": 1791970502501,
      "link": null,
      "locked": false,
      "text": "5. What fits the budget\nAn exact optimizer:\ntranslate the game,\nstore page only, or\nskip",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 88,
      "containerId": "s4",
      "originalText": "5. What fits the budget\nAn exact optimizer:\ntranslate the game,\nstore page only, or\nskip",
      "lineHeight": 1.15
    },
