      "boundElements": null,
      "updated": 1791970502503,
      "link": null,
      "locked": false,
      "text": "6. Plan + evidence\nEvery number\ntraceable; the LLM\nexplains it and code\nchecks it",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 88,
      "containerId": "s5",
      "originalText": "6. Plan + evidence\nEvery number\ntraceable; the LLM\nexplains it and code\nchecks it",
      "lineHeight": 1.15
    },
